# Copy once to .env (gitignored). Preserve existing private configuration.
# Default startup needs Python only; no model or cloud database calls.
SAFEGUARD_PORT=8765
SAFEGUARD_ANALYSIS_MODE=rules
SAFEGUARD_MEMORY_MODE=local
SAFEGUARD_DOMAIN_PROVIDER=none
SAFEGUARD_IP_PROVIDER=auto
# Blank uses server/local-data.
SAFEGUARD_DATA_DIR=
# Blank uses the data directory's blackips-snapshot subdirectory.
BLACKIPS_SNAPSHOT_DIR=
# Optional H-MEM: set SAFEGUARD_MEMORY_MODE=hmem; use Node.js 24 on PATH or here.
SAFEGUARD_NODE=

# Optional Zetaris: enable SAFEGUARD_DOMAIN_PROVIDER=zetaris after real setup.
# Verified bundle: ui_query uses the UI origin through a local tunnel.
# Never publish credentials. Remote endpoints require HTTPS.
ZETARIS_QUERY_ROUTE=ui_query
ZETARIS_BASE_URL=
ZETARIS_REST_URL=
ZETARIS_ORG_ID=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_API_KEY=
ZETARIS_ENGINE_ID=
ZETARIS_EVIDENCE_TABLE=security.domain_evidence
ZETARIS_QUERY_LIMIT=100
ZETARIS_TIMEOUT_SECONDS=60

# Optional official Nightshift: enable SAFEGUARD_ANALYSIS_MODE=model after setup.
# Use the real proxy token, never rt-local.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/local

# Optional BlackIPS HTTP service. Blank leaves auto using a local snapshot.
# SAFEGUARD_IP_PROVIDER=snapshot prevents remote-provider attempts altogether.
BLACKIPS_BASE_URL=
