{
  "manifest_version": 3,
  "name": "SafeGuard AI — Agent Companion",
  "version": "0.3.2",
  "description": "Visual browser assistant, cautious evidence screening and user-confirmed subscription reminders.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SafeGuard AI",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "key": ""
}
